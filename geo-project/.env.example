# ============================================================
# Sanhe GEO production environment template.
# Copy to .env on the server, fill real values, then chmod 600 .env.
# Do not commit the real .env file.
# ============================================================

# Image tags
IMAGE_TAG=v20260505-0000

# Host-local ports. Put the public reverse proxy in front of these ports.
WEB_HTTP_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Public domain. MinIO files are served under the same host through /oss/.
APP_PUBLIC_URL=https://www.huanjingaigeo.com
MINIO_PUBLIC_URL=https://www.huanjingaigeo.com/oss
MINIO_PUBLIC_ENDPOINT=https://www.huanjingaigeo.com/oss

# Spring / JVM
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai
# JVM 容器化参数:
# - MaxRAMPercentage=70.0 表示 JVM 堆最多使用容器内存的 70%,预留 30% 给 Chromium 和系统;生产容器规格变化时优先评估这个值。
# - ExitOnOutOfMemoryError 让 OOM 直接退出,外层 healthcheck/restart 才能感知并拉起新容器。
# - egd=urandom 加速 SecureRandom 初始化,减少启动阶段阻塞。
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 -XX:+UseContainerSupport -XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=40.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom
APP_LOG_LEVEL=info
GEO_SERVER_STOP_GRACE_PERIOD=45s
GEO_COOKIE_MASTER_KEY_BASE64=gtiJPMQ7f+d8IzF1dqFs06bf9wBeIcb981BWr4C5s6c=
# Upload limits. Keep these aligned with geo-web nginx.conf and the host reverse proxy.
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=50MB

# MySQL
MYSQL_ROOT_PASSWORD=djGeo@1994
MYSQL_DATABASE=geo_delivery
MYSQL_USER=geo_app
MYSQL_PASSWORD=geoApp@123
MYSQL_HOST=mysql
MYSQL_PORT=3306
DB_HIKARI_MAX_POOL_SIZE=16
DB_HIKARI_MIN_IDLE=4
DB_HIKARI_CONNECTION_TIMEOUT_MS=30000

# Redis
REDIS_PASSWORD=djGeo@1994
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# MinIO
MINIO_ROOT_USER=dj_geo_root
MINIO_ROOT_PASSWORD=djGeo@1994
MINIO_BUCKET=geo-files
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_SERVER_URL=https://www.huanjingaigeo.com/oss
MINIO_BROWSER_REDIRECT_URL=https://www.huanjingaigeo.com/oss
MINIO_APP_ACCESS_KEY=geo_app
MINIO_APP_SECRET_KEY=geoApp@123
# Application security
JWT_SECRET=K9vR3xN7pQ2mL5wT8yE4uH6jB1nA0sD9fG2hZ7cV5bX3qM8tY4rW6kP1oI
