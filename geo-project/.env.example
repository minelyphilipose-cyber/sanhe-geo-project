# ============================================================
# Sanhe GEO production environment template.
# Copy to .env on the server, fill real values, then chmod 600 .env.
# Do not commit the real .env file.
# ============================================================

# Image tags
IMAGE_TAG=v20260505-0000

# Host-local ports. Put the public reverse proxy in front of these ports.
WEB_HTTP_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Public domains
APP_PUBLIC_URL=https://geo.example.com
MINIO_PUBLIC_URL=https://oss.example.com

# Spring / JVM
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai
# JVM 容器化参数:
# - MaxRAMPercentage=70.0 表示 JVM 堆最多使用容器内存的 70%,预留 30% 给 Chromium 和系统;生产容器规格变化时优先评估这个值。
# - ExitOnOutOfMemoryError 让 OOM 直接退出,外层 healthcheck/restart 才能感知并拉起新容器。
# - egd=urandom 加速 SecureRandom 初始化,减少启动阶段阻塞。
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 -XX:+UseContainerSupport -XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=40.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom
APP_LOG_LEVEL=info
GEO_SERVER_STOP_GRACE_PERIOD=45s

# Upload limits. Keep these aligned with geo-web nginx.conf and the host reverse proxy.
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=50MB

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=geo_delivery
MYSQL_USER=geo_app
MYSQL_PASSWORD=replace-with-strong-app-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
DB_HIKARI_MAX_POOL_SIZE=10
DB_HIKARI_MIN_IDLE=2
DB_HIKARI_CONNECTION_TIMEOUT_MS=30000

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# MinIO
MINIO_ROOT_USER=geo_minio_root
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
MINIO_BUCKET=geo-files
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_SERVER_URL=https://oss.example.com
MINIO_BROWSER_REDIRECT_URL=https://oss.example.com
MINIO_APP_ACCESS_KEY=geo_app_minio
MINIO_APP_SECRET_KEY=replace-with-strong-minio-app-secret

# Application security
JWT_SECRET=replace-with-at-least-32-byte-random-secret
JWT_ACCESS_TOKEN_EXPIRE=7200
JWT_REFRESH_TOKEN_EXPIRE=604800
DISPATCH_API_KEY_AES_SECRET=replace-with-32-byte-random-dispatch-aes-secret
MP_CREDENTIAL_AES_SECRET=replace-with-32-byte-random-mp-aes-secret

# External service endpoints
REPORT_WEB_BASE_URL=http://geo-web
BRAND_GEO_SITE_ENDPOINT=https://brand-geo.example.com/api/v1/content
BRAND_GEO_SITE_CONNECT_TIMEOUT_MS=5000
BRAND_GEO_SITE_READ_TIMEOUT_MS=30000

# WeChat Open Platform
WECHAT_CLIENT_MODE=real
WECHAT_COMPONENT_APPID=replace-with-wechat-component-appid
WECHAT_COMPONENT_SECRET=replace-with-wechat-component-secret
WECHAT_TOKEN=replace-with-wechat-token
WECHAT_ENCODING_AES_KEY=replace-with-wechat-encoding-aes-key
WECHAT_DRAFT_DISTRIBUTION_ENABLED=false
WECHAT_FUNC_SCOPE_STRICT_MODE=true
WECHAT_AUTH_TYPE=1
WECHAT_BACKEND_AUTH_CALLBACK_URL=https://geo.example.com/api/wechat/open-platform/auth/callback
WECHAT_FRONTEND_CALLBACK_URL=https://geo.example.com/admin/content/execution

# Presale / report export
PRESALE_GENERATE_MOCK=false
PRESALE_ALLOW_SYNTHETIC_FALLBACK=false
PRESALE_EXPORT_BROWSER_ENABLED=true
PRESALE_EXPORT_BROWSER_PREHEAT=true
PRESALE_EXPORT_BROWSER_HEADLESS=true
PRESALE_EXPORT_MAX_CONCURRENCY=1
PRESALE_EXPORT_LOCAL_ROOT=/app/data/presale-exports

# Operations
SWAGGER_ENABLED=false
ACTUATOR_EXPOSURE=health
ACTUATOR_HEALTH_DETAILS=never

# Container resource limits. Tune to the host size; single-node production should be 8G minimum, 16G recommended.
GEO_SERVER_MEM_LIMIT=4g
GEO_SERVER_CPUS=2.0
GEO_WEB_MEM_LIMIT=256m
GEO_WEB_CPUS=0.5
MYSQL_MEM_LIMIT=2g
MYSQL_CPUS=1.5
REDIS_MEM_LIMIT=512m
REDIS_CPUS=0.5
MINIO_MEM_LIMIT=1g
MINIO_CPUS=1.0
