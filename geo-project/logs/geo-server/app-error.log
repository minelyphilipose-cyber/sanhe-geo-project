ALTER TABLE presale_report_version
    ADD COLUMN IF NOT EXISTS derived_from_version_id BIGINT NULL COMMENT '派生来源版本 ID' AFTER version_no,
    ADD COLUMN IF NOT EXISTS total_llm_calls INT NULL COMMENT '总 LLM 调用数',
    ADD COLUMN IF NOT EXISTS completed_llm_calls INT NULL COMMENT '已完成 LLM 调用数',
    ADD COLUMN IF NOT EXISTS is_degraded TINYINT(1) NOT NULL DEFAULT 0 COMMENT '是否降级',
