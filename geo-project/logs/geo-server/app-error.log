-- V67: presale_report_version schema compatibility patch
--
-- 场景:
--   部分环境 presale_report_version 表结构落后于当前实体映射,
--   createReport/derive 时会出现 Unknown column (如 completed_llm_calls)。
--
-- 目标:
--   以“幂等 + 最小侵入”方式补齐当前代码依赖列。
--   使用 ADD COLUMN IF NOT EXISTS,避免对已正确环境产生影响。
-- =========================================================================

ALTER TABLE presale_report_version
    ADD COLUMN IF NOT EXISTS derived_from_version_id BIGINT NULL COMMENT '派生来源版本 ID' AFTER version_no,
    ADD COLUMN IF NOT EXISTS total_llm_calls INT NULL COMMENT '总 LLM 调用数',
    ADD COLUMN IF NOT EXISTS completed_llm_calls INT NULL COMMENT '已完成 LLM 调用数',
    ADD COLUMN IF NOT EXISTS is_degraded TINYINT(1) NOT NULL DEFAULT 0 COMMENT '是否降级',
    ADD COLUMN IF NOT EXISTS degraded_platforms JSON NULL COMMENT '降级平台列表',
    ADD COLUMN IF NOT EXISTS failure_reason TEXT NULL COMMENT '失败原因',
    ADD COLUMN IF NOT EXISTS raw_snapshot_json JSON NULL COMMENT 'L1 原始快照',
    ADD COLUMN IF NOT EXISTS computed_snapshot_json JSON NULL COMMENT 'L2 计算快照',
    ADD COLUMN IF NOT EXISTS editable_content_json JSON NULL COMMENT 'L3 可编辑快照',
    ADD COLUMN IF NOT EXISTS frozen_at DATETIME NULL COMMENT '冻结时间',
    ADD COLUMN IF NOT EXISTS frozen_by BIGINT NULL COMMENT '冻结人',
    ADD COLUMN IF NOT EXISTS frozen_reason VARCHAR(100) NULL COMMENT '冻结原因',
    ADD COLUMN IF NOT EXISTS content_updated_at DATETIME NULL COMMENT '内容更新时间',
    ADD COLUMN IF NOT EXISTS export_success_count INT NOT NULL DEFAULT 0 COMMENT '导出成功次数',
    ADD COLUMN IF NOT EXISTS export_success_at DATETIME NULL COMMENT '最近导出成功时间',
    ADD COLUMN IF NOT EXISTS created_by BIGINT NULL COMMENT '创建人'

