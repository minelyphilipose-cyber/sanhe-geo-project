+    BaselineSemanticJudgeResult judge(BaselineQuestionSnapshot question,
+                                      Project project,
+                                      List<String> aliases,
+                                      List<BaselineObservationScoringRules.CompetitorName> competitors,
+                                      AiPlatformConfig judgePlatform,
+                                      String responseText) {
